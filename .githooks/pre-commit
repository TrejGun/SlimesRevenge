#!/usr/bin/env bash
# Format staged C# files with CSharpier (Prettier-style for this repo).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v dotnet >/dev/null 2>&1; then
  if [[ -x "${HOME}/.dotnet/dotnet" ]]; then
    export PATH="${HOME}/.dotnet:${PATH}"
  else
    echo "pre-commit: dotnet not found; skip CSharpier" >&2
    exit 0
  fi
fi

LIST="$(mktemp)"
trap 'rm -f "$LIST"' EXIT
git diff --cached --name-only --diff-filter=ACMR | grep -E '\.cs$' >"$LIST" || true
if [[ ! -s "$LIST" ]]; then
  exit 0
fi

dotnet tool restore >/dev/null
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  dotnet csharpier format "$f"
  git add -- "$f"
done <"$LIST"

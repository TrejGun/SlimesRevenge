# Shared editor defaults (Rider / VS / VS Code). CSharpier owns C# layout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{meta,asmdef,asmref}]
indent_size = 4

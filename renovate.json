{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "timezone": "Asia/Tbilisi",
  "schedule": [
    "before 5am on Saturday"
  ],
  "updateNotScheduled": false,
  "dependencyDashboard": true,
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
